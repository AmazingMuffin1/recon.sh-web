# Copy to .env (for local dev) or add these as Vercel Project → Environment Variables.
# All three keys are OPTIONAL — the matching phases are skipped cleanly when unset.
# Users can also paste their own keys per-scan via the Settings (Keys) button in the UI.

# Optional — enables the AbuseIPDB cross-reference phase (per-IP abuse/reports).
# Free key: https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=

# Optional — enables VirusTotal lookups (domain report, subdomains, URL scan
# archive, historical DNS resolutions). Free key, 500 req/day, 4/min.
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_KEY=

# Optional but strongly recommended — OTX rate-limits anonymous callers
# aggressively (often silently → empty results). Free key from
# https://otx.alienvault.com/api  lifts the limit.
OTX_API_KEY=

# Optional — set to 1 only if you self-host behind a proxy (nginx, ALB,
# Cloudflare) and want the rate limiter to read x-forwarded-for. On Vercel
# this is auto-enabled and you do NOT need to set it.
# TRUST_PROXY=1
